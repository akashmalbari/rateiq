# App
NEXT_PUBLIC_APP_URL=https://figuremymoney.com
NEXT_PUBLIC_SITE_NAME="Figure My Money"
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron and admin security
CRON_SECRET=replace-with-a-long-random-secret
SUPABASE_SCHEDULER_SECRET=replace-with-the-same-long-random-secret
ADMIN_EMAILS=founder@figuremymoney.com
# Legacy compatibility only: an email here is also accepted as an admin.
TRADING_ADMIN_USERNAME=

# Email
RESEND_API_KEY=re_...
RESEND_FROM="Figure My Money <signals@figuremymoney.com>"
RESEND_FROM_EMAIL=signals@figuremymoney.com

# Stripe Billing
BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_ESSENTIAL_PRICE_ID=price_...
STRIPE_PREMIUM_PRICE_ID=price_...

# Market data
# demo, polygon, tradier, finnhub, or composite
MARKET_DATA_PROVIDER=demo
POLYGON_API_KEY=
TRADIER_ACCESS_TOKEN=
TRADIER_API_KEY=
TRADER_API_KEY=
TRADIER_BASE_URL=https://api.tradier.com/v1
FINNHUB_API_KEY=
NASDAQ_100_SYMBOLS=

# Optional AI summaries
OPENAI_API_KEY=
